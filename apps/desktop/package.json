{
  "name": "resumeapplyr-desktop",
  "productName": "resumeapplyr",
  "desktopName": "resumeapplyr.desktop",
  "version": "0.1.0",
  "private": true,
  "description": "resumeapplyr for desktop: an AI agent that finds jobs and applies for you from your own computer.",
  "license": "UNLICENSED",
  "author": "resumeapplyr",
  "homepage": "https://resumeapplyr.pages.dev",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node tests/e2e/run.mjs",
    "test:packaged": "node tests/e2e/smoke-packaged.mjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "playwright-core": "1.56.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource/archivo": "5.3.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "playwright": "1.56.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  }
}
